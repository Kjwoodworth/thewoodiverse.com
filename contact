<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact | Kevin James Woodworth</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  font-family: 'Raleway', sans-serif;
  background: #0a0a0a;
  color: #f0ece0;
  min-height: 100vh;
}

html { scroll-behavior: smooth; }

/* GRAIN */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.5;
}

/* SIDE MENU */
.side-menu {
  position: fixed;
  top: 0; left: -320px;
  width: 280px; height: 100%;
  background: #0d0d0d;
  border-right: 1px solid rgba(212,175,55,0.15);
  padding: 90px 36px;
  transition: left 0.35s cubic-bezier(0.4,0,0.2,1);
  z-index: 2500;
}
.side-menu.open { left: 0; }
.side-menu a {
  display: block; margin-bottom: 24px;
  font-size: 12px; letter-spacing: 4px; text-transform: uppercase;
  text-decoration: none; color: #6b5e3a; font-weight: 600; transition: color 0.2s;
}
.side-menu a:hover { color: #FFD700; }

/* TOPBAR */
.topbar {
  position: fixed; top: 0; left: 0; right: 0; height: 64px;
  background: rgba(10,10,10,0.95);
  border-bottom: 1px solid rgba(212,175,55,0.12);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px; z-index: 2000; backdrop-filter: blur(8px);
}
.topbar-logo {
  font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 400;
  background: linear-gradient(90deg, #FFD700, #E1C699);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; text-decoration: none;
}
.topbar-nav { display: flex; gap: 32px; }
.topbar-nav a {
  text-decoration: none; font-size: 11px; font-weight: 600;
  letter-spacing: 3px; text-transform: uppercase; color: #6b5e3a; transition: color 0.2s;
}
.topbar-nav a:hover, .topbar-nav a.active { color: #FFD700; }
.hamburger {
  font-size: 20px; cursor: pointer; color: #8a7a50;
  background: none; border: none; z-index: 3000; transition: color 0.2s;
}
.hamburger:hover { color: #FFD700; }

/* PAGE */
.page-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 120px 40px 100px;
}

/* PAGE HEADER */
.page-header { margin-bottom: 70px; }
.page-header-eyebrow {
  font-size: 11px; letter-spacing: 5px; text-transform: uppercase;
  color: #6b5e3a; margin-bottom: 16px; font-weight: 500;
}
.page-header h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 5vw, 60px); font-weight: 400; margin: 0;
  background: linear-gradient(135deg, #FFD700 0%, #E1C699 50%, #c9a84c 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1.1;
}
.page-header-line {
  width: 60px; height: 2px;
  background: linear-gradient(90deg, #FFD700, transparent);
  margin-top: 24px;
}

/* MAIN GRID */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 80px;
  align-items: start;
}

/* LEFT COLUMN — INFO */
.contact-info { position: sticky; top: 100px; }

.contact-intro {
  font-size: 15px; line-height: 1.9; color: #c8c0a8;
  font-weight: 300; margin-bottom: 48px;
}

.contact-intro em {
  font-family: 'Playfair Display', serif;
  font-style: italic; color: #e8dfc8; font-size: 17px;
}

.contact-items { display: flex; flex-direction: column; gap: 28px; margin-bottom: 48px; }

.contact-item { display: flex; align-items: flex-start; gap: 18px; }

.contact-icon {
  width: 40px; height: 40px; flex-shrink: 0;
  border: 1px solid rgba(212,175,55,0.25);
  display: flex; align-items: center; justify-content: center;
  color: #8a7a50; transition: all 0.3s;
}

.contact-item:hover .contact-icon {
  border-color: rgba(212,175,55,0.6);
  color: #FFD700;
  background: rgba(212,175,55,0.04);
}

.contact-item-label {
  font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
  color: #4a4030; font-weight: 600; margin-bottom: 4px;
}

.contact-item-value {
  font-size: 14px; color: #c8c0a8; font-weight: 300;
  text-decoration: none; transition: color 0.2s;
  display: block;
}

.contact-item-value:hover { color: #FFD700; }

/* DIVIDER */
.section-divider {
  border: none;
  border-top: 1px solid rgba(212,175,55,0.12);
  margin: 40px 0;
}

/* RESUME DOWNLOAD */
.resume-block { }

.resume-label {
  font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
  color: #6b5e3a; font-weight: 600; margin-bottom: 16px;
}

.resume-download {
  display: inline-flex; align-items: center; gap: 12px;
  border: 1px solid rgba(212,175,55,0.3);
  padding: 16px 28px;
  text-decoration: none;
  font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
  color: #E1C699; font-weight: 600;
  transition: all 0.3s; position: relative; overflow: hidden;
}

.resume-download::before {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(212,175,55,0.06), transparent);
  transform: translateX(-100%);
  transition: transform 0.4s ease;
}

.resume-download:hover::before { transform: translateX(0); }

.resume-download:hover {
  border-color: rgba(212,175,55,0.6);
  color: #FFD700;
}

.resume-note {
  font-size: 11px; color: #4a4030; margin-top: 12px;
  letter-spacing: 1px; font-weight: 400;
}

/* RIGHT COLUMN — FORM */
.contact-form-wrap { }

.form-heading {
  font-family: 'Playfair Display', serif;
  font-size: 22px; font-weight: 400; color: #e8dfc8;
  margin-bottom: 8px;
}

.form-subheading {
  font-size: 13px; color: #6b5e3a; letter-spacing: 1px;
  margin-bottom: 36px; font-weight: 400;
}

.form-group { margin-bottom: 24px; }

.form-group label {
  display: block; font-size: 10px; letter-spacing: 3px;
  text-transform: uppercase; color: #6b5e3a; font-weight: 600;
  margin-bottom: 8px;
}

.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(212,175,55,0.15);
  padding: 14px 18px;
  color: #f0ece0;
  font-family: 'Raleway', sans-serif;
  font-size: 14px; font-weight: 300;
  outline: none;
  transition: border-color 0.3s, background 0.3s;
  border-radius: 0;
  -webkit-appearance: none;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  border-color: rgba(212,175,55,0.5);
  background: rgba(212,175,55,0.03);
}

.form-group input::placeholder,
.form-group textarea::placeholder { color: #3a3528; }

.form-group textarea { height: 140px; resize: vertical; }

.form-group select { cursor: pointer; }
.form-group select option { background: #111; color: #f0ece0; }

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

.submit-btn {
  width: 100%; padding: 18px;
  background: transparent;
  border: 1px solid rgba(212,175,55,0.4);
  color: #E1C699;
  font-family: 'Raleway', sans-serif;
  font-size: 11px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase;
  cursor: pointer; transition: all 0.3s; position: relative; overflow: hidden;
}

.submit-btn::before {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(212,175,55,0.1), rgba(212,175,55,0.05));
  transform: translateX(-100%);
  transition: transform 0.4s ease;
}

.submit-btn:hover::before { transform: translateX(0); }
.submit-btn:hover { border-color: rgba(212,175,55,0.7); color: #FFD700; }

/* SUCCESS MESSAGE */
.form-success {
  display: none;
  text-align: center; padding: 40px;
  border: 1px solid rgba(212,175,55,0.2);
  margin-top: 20px;
}

.form-success.show { display: block; }

.form-success h3 {
  font-family: 'Playfair Display', serif;
  font-size: 22px; color: #FFD700; font-weight: 400; margin-bottom: 8px;
}

.form-success p { font-size: 14px; color: #8a8070; font-weight: 300; }

/* LOCATION TAG */
.location-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: #4a4030; font-weight: 500; margin-top: 40px;
}

/* MOBILE */
@media (max-width: 768px) {
  .topbar-nav { display: none; }
  .page-wrap { padding: 100px 24px 60px; }
  .contact-grid { grid-template-columns: 1fr; gap: 50px; }
  .contact-info { position: static; }
  .form-row { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<!-- SIDE MENU -->
<div class="side-menu" id="sideMenu">
