    </div>

    <!-- RIGHT: FORM -->
    <div class="contact-form-wrap">
      <h2 class="form-heading">Send a Message</h2>
      <p class="form-subheading">I'll get back to you as soon as possible.</p>

      <!-- Formspree form — replace YOUR_FORM_ID with your actual Formspree ID -->
      <form id="contactForm" action="https://formspree.io/f/xwvnzelw" method="POST">

        <div class="form-row">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="Jane Smith" required>
          </div>
          <div class="form-group">
            <label for="email">Your Email</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required>
          </div>
