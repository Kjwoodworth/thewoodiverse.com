</div>

<!-- TOPBAR -->
<nav class="topbar">
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">☰</button>
  <a href="index.html" class="topbar-logo">KJW</a>
  <div class="topbar-nav">
    <a href="about.html">About</a>
    <a href="portfolio.html">Portfolio</a>
